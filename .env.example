# Copy to .env and adjust. The real .env is gitignored.

# Host path to the photo library mounted at /library.
# Replacement writes here; review and stitching only need read access.
PHOTO_LIBRARY=./photos

# Host path for SQLite, thumbnails, stitches, and trash. Use a POSIX filesystem.
DATA_DIR=./data

# Host address for the published web port. The service has no authentication.
# Keep 127.0.0.1 for local use, or set the LAN IP address explicitly.
BIND_ADDRESS=127.0.0.1

# Published host port. The container always listens on 3040.
PORT=3040
